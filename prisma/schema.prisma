generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model Profile {
  id Int @id
  name String
  description String
  links Link[]
  skills Skill[]
  experience Experience[]
  projects Project[]
}
model Link {
  id Int @id @default(autoincrement())
  label String
  url String
  profileId Int
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}
model Skill {
  id Int @id @default(autoincrement())
  name String
  profileId Int
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}
model Experience {
  id Int @id @default(autoincrement())
  company String
  position String
  period String
  achievements String[]
  profileId Int
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}
model Project {
  id Int @id @default(autoincrement())
  name String
  description String
  url String?
  profileId Int
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}
